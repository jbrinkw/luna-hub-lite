{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@playwright/test", "node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "scenarios/**/*.ts",
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "__tests__/**/*.ts",
    "invariants.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
