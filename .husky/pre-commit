#!/usr/bin/env sh
# pre-commit — lint-staged + Verify-skipped scanner.
#
# The scanner inspects HEAD's commit message for a `Verify-skipped:` footer.
# That marker is the convention for tracking deliberate `--no-verify` bypasses.
# If found AND the bypass hasn't been resolved by a follow-up commit citing
# `Verify-resolved-by: <sha>`, this hook prints a LOUD warning to remind the
# author to schedule the follow-up. (It does NOT block — but the visibility
# itself is the deterrent.)

# Fail loudly on any error (e.g. lint-staged finds a violation). The original
# version had no `set -e`, so a lint-staged failure was silently masked by
# the trailing scanner block returning exit 0 — surfaced by Codex audit.
set -e

npx lint-staged

# Scan HEAD for unresolved Verify-skipped footers.
if git rev-parse HEAD >/dev/null 2>&1; then
  HEAD_MSG="$(git log -1 --format=%B HEAD 2>/dev/null || true)"
  if printf '%s' "$HEAD_MSG" | grep -qiE '^Verify-skipped:'; then
    HEAD_SHA="$(git rev-parse --short HEAD)"
    # Look for any later commit that resolves this one.
    if ! git log --grep="Verify-resolved-by: ${HEAD_SHA}" --format=%H "${HEAD_SHA}..HEAD" 2>/dev/null | grep -q .; then
      printf '\n\033[1;33m⚠️  Last commit (%s) used --no-verify (Verify-skipped: footer present).\033[0m\n' "$HEAD_SHA" >&2
      printf '\033[1;33m   Resolve with a follow-up commit including footer: Verify-resolved-by: %s\033[0m\n\n' "$HEAD_SHA" >&2
    fi
  fi
fi
