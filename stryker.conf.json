{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_": [
    "Root Stryker config. Scoped to @luna-hub/app-tools workspace because it has",
    "the most mature vitest setup in node env and hosts all MCP tool handlers",
    "(the primary 'contract' layer). apps/mcp-worker and apps/web/shared are",
    "deferred follow-ups — see scripts/mutation/README.md for rationale."
  ],

  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],

  "vitest": {
    "configFile": "packages/app-tools/vitest.config.ts",
    "dir": "packages/app-tools"
  },

  "coverageAnalysis": "perTest",
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "concurrency": 2,

  "mutate": [
    "packages/app-tools/src/**/*.ts",
    "!packages/app-tools/src/**/*.test.ts",
    "!packages/app-tools/src/**/*.spec.ts",
    "!packages/app-tools/src/__tests__/**",
    "!packages/app-tools/src/types.ts",
    "!packages/app-tools/src/index.ts"
  ],

  "ignorePatterns": [
    "dist",
    "coverage",
    "legacy",
    "hardware",
    "supabase/migrations",
    "packages/db-types/src/database.ts",
    "**/*.tsbuildinfo",
    ".verify",
    ".turbo",
    ".wrangler",
    ".vercel",
    ".stryker-tmp"
  ],

  "reporters": ["progress", "clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },

  "thresholds": {
    "high": 60,
    "low": 40,
    "break": 40
  },

  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
