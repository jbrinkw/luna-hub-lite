# Live Shelf server — runtime config template.
# Copy to `.env` and fill in. `.env` is gitignored.

# Required for classifier calls. Without it, /api/scale-event still
# records events but classification falls back to "unknown".
ANTHROPIC_API_KEY=

# Classifier model. See docs/plan.md §7.2 for the cheap/escalate path.
LIVE_SHELF_MODEL=claude-sonnet-4-6

# Camera (index into /dev/videoN; 0 == /dev/video0 on the Pi)
CAMERA_INDEX=0
CAMERA_DEVICE=/dev/video0
RESOLUTION_WIDTH=1280
RESOLUTION_HEIGHT=720
CAPTURE_FPS=10

# Brightness watcher thresholds (0..255 mean luma)
BRIGHTNESS_THRESHOLD=60
BRIGHTNESS_HYSTERESIS=20

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Scale / classifier knobs
EVENT_DELTA_THRESHOLD_G=5.0
FRAME_LOOKBACK_SECONDS=2.0
RECENTLY_OUT_WINDOW_SECONDS=86400
DEDUP_LRU_SIZE=2048

# Storage
DATA_DIR=./data

# Logging
LOG_LEVEL=INFO

# Cloud integration (PROD_MIGRATION_PLAN.md). Leave disabled to run the
# Pi standalone. When enabled, every scale event fetches /catalog from
# the Supabase shelf-ingest edge function and posts the resolved event
# back via /event. Offline events queue in cloud_outbox and drain when
# the network returns.
CLOUD_ENABLED=false
# Fully-qualified URL to the edge function root, e.g.
# https://abc.supabase.co/functions/v1
CLOUD_URL=
# Per-device import key (matches a row in chefbyte.live_shelf_devices).
CLOUD_IMPORT_KEY=
# Heartbeat cadence (seconds). Worker drains the outbox on the same tick.
CLOUD_HEARTBEAT_INTERVAL_S=30
