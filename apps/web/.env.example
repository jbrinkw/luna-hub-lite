VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# MCP Worker base URL. Used by the Hub MCP Settings page (endpoint +
# /test-extension-creds) and the AI Agent page (/v1/chat/completions).
# Override for local dev (e.g. http://localhost:8787 when running
# `wrangler dev` in apps/mcp-worker). Leave unset to fall through to
# the production fallback (https://mcp.lunahub.dev).
VITE_MCP_URL=https://mcp.lunahub.dev
